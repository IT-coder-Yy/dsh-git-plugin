{
  "name": "deepseek-git-guide",
  "version": "0.1.0",
  "description": "DeepSeek Harness Cordis 插件（静态 npm 包形态）：把用户对 git 操作的自然语言描述，转成最简洁安全的命令建议与解释，并让用户在「直接执行 / 手动执行」之间选择。",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./git-guide.cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "git-assistant",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-coder-Yy/deepseek-git-guide.git"
  },
  "homepage": "https://github.com/IT-coder-Yy/deepseek-git-guide#readme",
  "bugs": {
    "url": "https://github.com/IT-coder-Yy/deepseek-git-guide/issues"
  },
  "files": [
    "lib",
    "git-guide.cordis.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  }
}
