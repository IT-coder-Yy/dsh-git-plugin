{
  "name": "deepseek-git-guide",
  "version": "1.0.0",
  "description": "DeepSeek Harness Cordis 插件（静态 npm 包形态）：把用户对 git 操作的自然语言描述，转成最简洁安全的命令建议与解释，并让用户在「直接执行 / 手动执行」之间选择。",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-shell": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "git-assistant",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-github-name>/deepseek-git-guide.git"
  },
  "files": [
    "lib",
    "git-guide.cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test \"test/*.test.js\""
  }
}
